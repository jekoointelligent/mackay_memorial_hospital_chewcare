# ── Supabase（在 Supabase 專案 → Settings → API 取得）──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key   # 機密，僅後端使用，絕不可放前端或 commit

# ── Session 簽章密鑰（請使用隨機長字串）──
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_at_least_32_chars

# ── 後台管理員帳密（初次啟動時自動建立到 admin_users）──
ADMIN_EMAIL=admin@your-org.com
ADMIN_PASSWORD=your_strong_admin_password

# ── Cloudflare R2（在 Cloudflare → R2 → Manage R2 API Tokens 建立）──
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key   # 機密，絕不可放 NEXT_PUBLIC 或 commit
R2_BUCKET_NAME=chewcare-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
